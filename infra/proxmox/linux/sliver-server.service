[Unit]
Description=BOFBench isolated Sliver control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sliver
Group=sliver
Environment=HOME=/var/lib/sliver
EnvironmentFile=/etc/bofbench/sliver.env
ExecStart=/usr/local/bin/sliver-server daemon --lhost ${SLIVER_LHOST} --lport ${SLIVER_LPORT}
WorkingDirectory=/var/lib/sliver
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sliver

[Install]
WantedBy=multi-user.target
